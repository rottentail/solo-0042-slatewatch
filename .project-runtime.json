{
  "project_shape": "fullstack",
  "language": "Python 3.12+ / HTML / CSS / JavaScript",
  "source_extensions": [
    ".py",
    ".html",
    ".css",
    ".js"
  ],
  "testing": "deferred",
  "build_command": "python3 -m compileall -q slatewatch",
